# Copy to .env and fill in what you need. Docker Compose reads it automatically.

# ---- Owners --------------------------------------------------------------------------
# Always administrators. Comma separated.
SUPER_ADMIN_EMAILS=jhonathanmaster@gmail.com

# ---- Ports and database ----------------------------------------------------------------
# App at http://localhost:3001 and Postgres on localhost:5433 (so it can run next to AssetPlus).
APP_PORT=3001
POSTGRES_PORT=5433
# Password of the bundled Postgres container. Change it before using real data on a server.
# POSTGRES_PASSWORD=geiatienda
# Only for `npm run dev` outside Docker (Docker Compose sets its own):
DATABASE_URL=postgres://geiatienda:geiatienda@localhost:5433/geiatienda
# Managed Postgres (e.g. DigitalOcean) requires TLS:
# DATABASE_SSL=true

# ---- Public address --------------------------------------------------------------------
# Used for invitation links and the Google return URL.
# PUBLIC_URL=http://localhost:3001
# Production behind HTTPS:
# PUBLIC_URL=https://geiatienda.com
# COOKIE_SECURE=true
# TRUST_PROXY=true
# Extra origins allowed to send changes (comma separated):
# ALLOWED_ORIGINS=

# ---- Sign-in ---------------------------------------------------------------------------
# Google: create an OAuth "Web application" client with redirect URI <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email + password sign-in (for invited people and the owner). false = Google only.
PASSWORD_LOGIN_ENABLED=true

# ---- Email (invitations, purchase orders, quotations, contact form) -----------------------
# Gmail with an app password (Google account → Security → App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Other SMTP provider (optional): uses GMAIL_USER / GMAIL_APP_PASSWORD as user / password.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# Who receives copies of purchase orders, receptions and quotations (default: first owner).
# ADMIN_NOTIFICATION_EMAIL=
# Inbox for the public contact form.
# CONTACT_EMAIL=grupoempresarialinversonessas@gmail.com
